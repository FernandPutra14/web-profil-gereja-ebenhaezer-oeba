<!-- CSS ckEditor 5-->
<link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/42.0.1/ckeditor5.css" />
<!-- Akhir CSS ckEditor 5-->
<!-- JS ckEditor5 -->
<script type="module">
    import {
        ClassicEditor,
        Essentials,
        Paragraph,
        Bold,
        Italic,
        List
    } from 'ckeditor5';

    ClassicEditor
        .create(document.querySelector('.editorberkelas'), {
            plugins: [Essentials, Paragraph, Bold, Italic, List ],
            toolbar: ['bold', 'italic', 'numberedList', 'bulletedList']
        })
        .then(editor => {
            editor.ui.view.editable.element.style.height = '200px';
        })
        .catch(error => {
            console.error(error);
        });
</script>
<!-- Akhir JS ckEditor5 -->