<!-- Layout Utama -->
@using PKMGerejaEbenhaezer.Web.Services.ToastrNotification
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gereja Ebenhaezer Oeba</title>
    <link rel="icon" href="/img/logo(32).png" type="image/png"/>
    

    <!-- Inisialisasi CSS Global -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Akhir Inisialisasi CSS Global -->


    <!-- Inisialisasi Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Akhir Inisialisasi Bootstrap CSS -->


    <!-- Inisialisasi RemixIcon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.css" />
    <!-- Akhir Inisialisasi RemixIcon -->


    <!-- Inisialisasi Owl Carousel -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />
    <!-- Akhir Inisialisasi Owl Carousel -->


    <!-- Inisialisasi Font Awesome -->
    <link href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet">
    <!-- Akhir Inisialisasi Font Awesome -->


    <link rel="stylesheet" href="~/PKMGerejaEbenhaezer.Web.styles.css" asp-append-version="true" />


    <!-- Inisialisasi Data-Aos Animation -->
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <!-- Akhir Inisialisasi Data-Aos Animation -->

    <script type="importmap">
        {
            "imports": {
                "ckeditor5": "https://cdn.ckeditor.com/ckeditor5/43.0.0/ckeditor5.js",
                "ckeditor5/": "https://cdn.ckeditor.com/ckeditor5/43.0.0/"
            }
        }
    </script>
</head>
<body>
    <!-- Go to top Section -->
    <div id="progress">
        <span id="progress-value">
            <i class="ri-arrow-up-s-line"></i>
        </span>
    </div>
    <!-- Akhir Go to top Section -->


    <!-- Navbar -->
    <partial name="_NavbarPartial" />
    <!-- Akhir Navbar -->


    <!-- Body -->
    <div class="container-fluid badan-utama">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <!-- Akhir Body -->


    <!-- Footer -->
    <footer>
        <div class="copyrightText">
            <img src="~/img/Logo_lppm.png" />
            <p>Copyright &copy;2024 LPPM Undana. All rights Reserved.</p>
        </div>
    </footer>
    <!-- Akhir Footer -->


    <!-- Script-Script js -->
    <!-- Inisisalisasi JQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Akhir Inisisalisasi JQuery -->


    <!-- Inisisalisasi Chart.JS -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <!-- Akhir Inisisalisasi Chart.JS -->


    <!-- Inisisalisasi Owl Carousel -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <!-- Akhir Inisisalisasi Chart.JS -->


    <!-- Inisisalisasi Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Akhir Inisisalisasi Bootstrap JS -->


    <!-- Inisisalisasi Data-Aos Animation -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init();
    </script>
    <!-- Akhir Inisisalisasi Data-Aos Animation -->


    <!-- Inisisalisasi JS File -->
    <script src="~/js/parallax.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/goTop.js" asp-append-version="true"></script>
    <script src="~/js/carousel.js" asp-append-version="true"></script>

    @{
        var options = new ToastrOptions
        {
            closeButton = true,
            progressBar = true,
            newestOnTop = true,
            preventDuplicates = false,
            timeOut = (int)TimeSpan.FromSeconds(5).TotalMilliseconds,
            extendedTimeOut = (int)TimeSpan.FromSeconds(5).TotalMilliseconds,
            showDuration = (int)TimeSpan.FromSeconds(0.5).TotalMilliseconds,
            hideDuration = (int)TimeSpan.FromSeconds(0.5).TotalMilliseconds,
            showEasing = Easings.Swing,
            hideEasing = Easings.Swing,
            showMethod = AnimationMethods.FadeIn,
            hideMethod = AnimationMethods.FadeOut,
            positionClass = PositionClasses.TopRight,
        };
    }
    <vc:toastr global-options=options></vc:toastr>

    <script type="text/javascript">
        //Toggle
        const menuBtn = $('.main-navbar .menu-btn');
        const menuList = $('.main-navbar .nav-list');
        const menuListItems = $('.nav-list li a');

        $(menuBtn).on('click', function () {
            $(menuBtn).toggleClass('active');
            $(menuList).toggleClass('active');
        });

        menuListItems.each(function (index, item) {
            $(item).on('click', menuItemClicked);
        });

        function menuItemClicked() {
            $(menuBtn).removeClass('active');
            $(menuList).removeClass('active');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>