<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gereja Ebenhaezer Oeba</title>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Owl Carousel -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />
    <!-- Akhir Owl Carousel -->
    <!-- Font Awesome -->
    <link href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet">
    <!-- Akhir Font Awesome-->
    <link rel="stylesheet" href="~/PKMGerejaEbenhaezer.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
</head>
<body>
    <!-- Go to top -->
    <div id="progress">
        <span id="progress-value">
            <i class="ri-arrow-up-s-line"></i>
        </span>
    </div>
    <!-- Akhir Go to top -->

    <!-- Navbar -->
    <partial name="_NavbarPartial" />
    <!-- Navbar -->
    <!-- Body -->
    <div class="container-fluid badan-utama">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <!-- Akhir Body -->
    <!-- Footer -->
    <footer>
        <div class="copyrightText">
            <p>Copyright &copy;2024 LPPM Undana. All rights Reserved.</p>
        </div>
    </footer>
    


    <!-- Akhir Footer -->
    <!-- Akhir HomePage Section -->
    <!-- Script js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init();
    </script>
    <script type="text/javascript" src="~/js/parallax.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/goTop.js" asp-append-version="true"></script>
    <script src="~/js/carousel.js" asp-append-version="true"></script>


    <script type="text/javascript">
        //Toggle Bang
        const menuBtn = $('.main-navbar .menu-btn');
        const menuList = $('.main-navbar .nav-list');
        const menuListItems = $('.nav-list li a');

        $(menuBtn).on('click', function () {
            $(menuBtn).toggleClass('active');
            $(menuList).toggleClass('active');
        });

        menuListItems.each(function (index, item) {
            $(item).on('click', menuItemClicked);
        });

        function menuItemClicked() {
            $(menuBtn).removeClass('active');
            $(menuList).removeClass('active');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
