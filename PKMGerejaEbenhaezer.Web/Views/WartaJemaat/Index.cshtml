@using System.Globalization
@model IndexVM<WartaJemaat>
@{
    ViewData["Title"] = "Warta Jemaat";
    var cultureInfo = new CultureInfo("id-ID");
}

@* Bagian Top dan Judul *@
<section id="warta-us">
    <h2>
        WARTA JEMAAT
    </h2>
</section>
@* Akhir Bagian Top dan Judul *@

<form asp-action="Index" method="get">
    <select asp-for="@Model.Tahun" class="form-control">
        <option value="@null">Semua</option>
        @for(int tahun = 2024; tahun >= 2000; tahun--)
        {
            <option value="@tahun">@tahun</option>
        }
    </select>
    <select asp-for="@Model.Bulan" class="form-control">
        <option value="@null">Semua</option>
        @for (int bulan = 1; bulan <= 12; bulan++)
        {
            <option value="@bulan">@Model.MonthName(bulan)</option>
        }
    </select>
    <button type="submit" class="btn btn-primary">Filter</button>
</form>

@foreach (var item in Model.Items)
{
    <h1>@item.TanggalWarta.ToString(cultureInfo)</h1>
    <br />
}

@section Scripts {
    <script type="text/javascript">
        $(function () {
            $('.badan-utama').css({
                'padding-left': '0',
                'padding-right': '0',
                'padding-top': '0rem',
            });
            $('.main-navbar').css({
                'position': 'fixed',
                'box-shadow': '4px 4px 4px rgba(0, 0, 0, 0.3)',
                'background-color': 'var(--primary-clr)',
            });
        });

        function openModal() {
            document.getElementById("filterModal").style.display = "block";

        }

        function closeModal() {
            document.getElementById("filterModal").style.display = "none";

        }

        window.onclick = function (event) {
            if (event.target == document.getElementById("filterModal")) {
                closeModal();
            }
        }
    </script>
}