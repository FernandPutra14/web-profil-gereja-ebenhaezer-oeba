@using PKMGerejaEbenhaezer.Web.Models.Account
@model EditVM
@{
    ViewData["Title"] = "Edit Akun";
}

<!-- Content Manajemen Akun Section -->
<div class="containerkun">
    <div class="jud">
        <h1>
            MANAJEMEN AKUN PENGGUNA
        </h1>
        <p>Setelah Akun berhasil diubah anda akan log out dan diarahkan ke halaman login untuk login dengan user name dan password baru!!</p>
    </div>
    
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="form-text text-danger"></div>

        <!-- Username -->
        <div class="row">
            <div class="col-md-12 col-12 input-box">
                <label asp-for="@Model.UserName" class="form-label"></label>
                <input asp-for="@Model.UserName" class="form-control" type="text" autocomplete="new-username" />
                <span asp-validation-for="@Model.UserName" class="form-text text-danger"></span>
            </div>
        </div>

        <!-- Password -->
        <div class="row">
            <div class="col-md-6 col-12 input-box">
                <label asp-for="@Model.Password" class="form-label"></label>
                <div class="input-wrapper">
                    <input asp-for="@Model.Password" type="password" class="form-control" id="password" autocomplete="new-password" />
                    <i class="ri-eye-line toggle-password" id="togglePassword"></i>
                </div>
                <span asp-validation-for="@Model.Password" class="form-text text-danger"></span>
            </div>
            <div class="col-md-6 col-12 input-box">
                <label asp-for="@Model.PasswordConfirmation" class="form-label"></label>
                <div class="input-wrapper">
                    <input asp-for="@Model.PasswordConfirmation" type="password" class="form-control" id="password-confirmation" />
                    <i class="ri-eye-line toggle-password" id="togglePasswordConfirmation"></i>
                </div>
                <span asp-validation-for="@Model.PasswordConfirmation" class="form-text text-danger"></span>
            </div>
        </div>

        <!-- Tombol Simpan -->
        <div class="row mt-5">
            <div class="col-12">
                <button type="submit" class="btn" style="width:100%;">Simpan</button>               
            </div>
        </div>
    </form>
</div>
<!-- Akhir Content Manajemen Akun Section -->


<!-- Script JS -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script type="text/javascript">
        $(document).ready(function () {
            $('.toggle-password').on('click', function () {
                const passwordInput = $(this).siblings('input');
                const type = passwordInput.attr('type') === 'password' ? 'text' : 'password';
                passwordInput.attr('type', type);
                $(this).toggleClass('ri-eye-off-line ri-eye-line');
            });
        });
    </script>


    <partial name="_NonTransparantNavbarPartial" />
}