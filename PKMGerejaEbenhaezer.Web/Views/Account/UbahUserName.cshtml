@using PKMGerejaEbenhaezer.Web.Models.Account
@model UbahUserNameVM
@{
    ViewData["Title"] = "Ubah User Name";
}

<div class="container">
    <form asp-action="UbahUserName">
        <div asp-validation-summary="ModelOnly" class="form-text text-danger"></div>

        <div class="row">
            <div class="col-12">
                <label asp-for="@Model.UserName" class="form-label"></label>
                <input asp-for="@Model.UserName" class="form-control" type="text" autocomplete="new-username" />
                <span asp-validation-for="@Model.UserName" class="form-text text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Simpan</button>
                <p class="form-text">Setelah User Name berhasil diubah anda akan log out dan diarahkan ke halaman login untuk login dengan User Name baru.</p>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}