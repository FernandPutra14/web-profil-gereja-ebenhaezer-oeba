@using PKMGerejaEbenhaezer.Web.Models.IbadahModels
@using System.Globalization
@model Ibadah
@{
    ViewData["Title"] = "Ibadah";
    var cultureInfo = new CultureInfo("id-ID");
}


<!-- Content Detail Ibadah Section -->
<section id="blog-container">
    <div class="blogs">
        <div class="post">
            <!-- Image -->
            <div class="row atas">
                <img src="~/img/detail/pray-ibadah2.jpg" />
            </div>
            <!-- Anchor Kembali -->
            <div>
                <ul class="breadcrumbs mt-2">
                    <li><a asp-action="Index">Semua Ibadah</a></li>
                    <li class="divider">/</li>
                    <li><a href="#" class="active">@Model.KategoriIbadah!.Nama</a></li>
                </ul>
            </div>
            <!-- Judul -->
            <div class="row">
                <h3 class="" style="font-weight:600">@Model.Judul</h3>
            </div>
            <!-- Kategori Ibadah -->
            <div class="row">
                <h4 class="">@Model.KategoriIbadah!.Nama</h4>
            </div>

            <!-- Pendeta -->
            <div class="pendeta-detail mt-2">
                <div>
                    @if(Model.Pendeta?.Foto is not null){
                        <partial name="_PictureFotoPartial" model=@((Model.Pendeta.Foto.Id, ""))/>
                    }
                    else
                    {
                        <img src="~/img/default_image/pendeta-test.jpg" />
                    }
                </div>
                <div style="margin-top: 5px; margin-left:10px;">
                    <h6 class="">@Model.Pendeta!.Nama</h6>
                </div>

            </div>
            <!-- Tempat, Tanggal, Jam -->
            <div class="info-ibd">

                <h5><i class="ri-map-pin-range-line" style="padding-right: 3px;"></i>@Model.Tempat</h5>
                <h5>
                    <i class="ri-calendar-schedule-line" style="padding-right:3px;"></i>
                    @Model.TanggalIbadah.ToString(cultureInfo.DateTimeFormat.LongDatePattern, cultureInfo)
                </h5>
                <h5>
                    <i class="ri-time-line" style="padding-right: 3px;"></i>
                    @Model.TanggalIbadah.ToString("hh:mm tt") -
                    @Model.TanggalIbadah.Add(Model.KategoriIbadah.Durasi).ToString("hh:mm tt")
                </h5>
            </div>


            <!-- Deskripsi Ibadah -->
            <div class="deskripsi-ibadah">
                @Html.Raw(Model.Deskripsi)
            </div>
            <!-- Renungan -->
            <div class="nats">
                <!-- Nats Renungan -->
                @if (Model.Renungan is not null)
                {
                    <h5>Nats Renungan</h5>
                    <p>
                        @Model.Renungan
                        <br />
                        @Html.Raw(Model.IsiRenungan)
                    </p>
                }

                <!-- Nats Pembimbing -->
                <h5>Nats Pembimbing</h5>
                <p>
                    @Model.NasPembimbing
                    <br />
                    @Html.Raw(Model.IsiNasPembimbing)
                </p>
            </div>

        </div>
    </div>
</section>
<!-- Akhir Content Detail Ibadah Section -->
<!-- Script JS -->
@section Scripts {
    <partial name="_NonTransparantNavbarPartial" />
}