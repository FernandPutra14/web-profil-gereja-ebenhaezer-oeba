@using System.Globalization
@model IndexVM<Pengumuman>
@{
    ViewData["Title"] = "Pengumuman";
    var cultureInfo = new CultureInfo("id-ID");
}

@* Bagian Top dan Judul *@
<section id="peng-us">
    <h2>
        PENGUMUMAN@(Model.Title())
    </h2>
</section>
@* Akhir Bagian Top dan Judul *@

<section class="peng">

    @* Tombol Filter *@
    @* <div class="filterbut">
        <a asp-action="Index" data-name="semua" class="@(Model.FilterCssClass())">Semua</a>
        @for (int i = 1; i <= 12; i++)
        {
            <a asp-action="Index" asp-route-bulan="@i"
               class="@(Model.FilterCssClass(i))"
               data-name="bulan">@(Model.MonthName(i))</a>
        }
    </div>
    <div class="tengbutfil">
        <button class="filter-button" onclick="openModal()">Filter</button>
    </div> *@
    @* Modal *@
    @* <div id="filterModal" class="modal">
        <div class="modal-content">
            <div class="cos">
                <h1 style="width:90%; margin-top:10px; vertical-align:middle;" class="">Pilihan Filter</h1>
                <span class="close" onclick="closeModal()"><i class="ri-close-fill"></i></span>
            </div>

            <div class="filterbut-modal">
                <a asp-action="Index" data-name="semua" class="@(Model.FilterCssClass())">Semua</a>
                @for (int i = 1; i <= 12; i++)
                {
                    <a asp-action="Index" asp-route-bulan="@i"
                       class="@(Model.FilterCssClass(i))"
                       data-name="bulan">@(Model.MonthName(i))</a>
                }
            </div>
        </div>
    </div> *@
    @* AKhir Tombol Filter *@

    <form asp-action="Index" method="get">
        <div class="row mb-2">
            <div class="col-md-5 col-6 input-box select-container">
                <label asp-for="@Model.Tahun" class="form-label">Filter Tahun</label>
                <div class="custom-select-wrapper">
                <select asp-for="@Model.Tahun" class="custom-select">
                    <option value="@null">Semua</option>
                    @for (int tahun = DateTime.Now.Year; tahun >= 2000; tahun--)
                    {
                        <option value="@tahun">@tahun</option>
                    }
                </select>
                <div class="custom-arrow"></div>
            </div>
            </div>
            <div class="col-md-5 col-6 input-box select-container">
                <label asp-for="@Model.Bulan" class="form-label">Filter Bulan</label>
                <div class="custom-select-wrapper">
                <select asp-for="@Model.Bulan" class="custom-select">
                    <option value="@null">Semua</option>
                    @for (int bulan = 1; bulan <= 12; bulan++)
                    {
                        <option value="@bulan">@Model.MonthName(bulan)</option>
                    }
                </select>
            <div class="custom-arrow"></div>
        </div>
            </div>
            <div class="col-md-2 col-12 mb-3" style="padding-top:23px;">
                <button type="submit" class="btn" style="width:100%;">Filter</button>
            </div>
        </div>
    </form>

    @* Search *@
    <div class="row penc">
        <form asp-action="Index" method="get" class="form-inline w-100">
            <div class="input-group" id="search">
                <input type="hidden" name="bulan" id="bulan" value="@Model.Bulan" />
                <input type="hidden" name="tahun" id="tahun" value="@Model.Tahun"/>
                <input type="text" id="searchString" name="searchString" value="@Model.SearchString"
                       class="form-control" placeholder="Cari Pengumuman..." required
                       oninvalid="this.setCustomValidity('Masukkan kata/kalimat yang ingin dicari')"
                       oninput="this.setCustomValidity('')" />
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary">Cari</button>
                </div>
            </div>
        </form>
    </div>
    @* Akhir Search *@

    @* Content Pengumuman *@
    <div class="peng-contents">
        @if (Model.Items.Count > 0)
        {
            @foreach (var item in Model.Items)
            {
                <!-- Ini Cardnya Bang -->
                <div class="item peng-card">
                    @if (item.Foto != null)
                    {
                        <img src="@Url.Action("Index", "Foto", new { Area = "", id = item.Foto!.Id })" />
                    }
                    else
                    {
                        <img src="~/img/gereja1.jpg" />
                    }
                    @* <div class="category">
                        <div class="subject">
                            <h3>Pengumuman</h3>
                        </div>
                    </div> *@
                    <h2 class="peng-title">@item.Judul</h2>
                    <p>@item.Isi</p>
                    <div class="peng-tanggal">
                        <span><i class="ri-calendar-fill"></i>@item.TanggalDiBuat.ToString(cultureInfo.DateTimeFormat.LongDatePattern, cultureInfo)</span>
                        <a asp-action="Detail" asp-controller="Pengumuman" asp-route-id="@item.Id"
                           class="tombolseleng">Baca Selengkapnya...</a>
                    </div>
                </div>
                <!-- Ini Akhir Cardnya Bang -->
            }
        }
        else
        {
            <h1 class="text-center">Tidak Ada Pengumuman</h1>
        }

    </div>
    @* Akhir Content Pengumuman *@

    @* Pagination *@
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Items.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.Items.PageIndex - 1)"
                   asp-route-bulan="@Model.Bulan" asp-route-tahun="@Model.Tahun" 
                   asp-route-searchString="@Model.SearchString">
                    Sebelumnya
                </a>
            </li>
            @for (var i = 1; i <= Model.Items.TotalPages; i++)
            {
                <li class="page-item @(Model.Items.PageIndex == i ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageIndex="@i" 
                        asp-route-bulan="@Model.Bulan" asp-route-tahun="@Model.Tahun" 
                        asp-route-searchString="@Model.SearchString">@i</a>
                </li>
            }
            <li class="page-item @(Model.Items.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.Items.PageIndex + 1)"
                   asp-route-bulan="@Model.Bulan" asp-route-tahun="@Model.Tahun"
                   asp-route-searchString="@Model.SearchString">
                    Selanjutnya
                </a>
            </li>
        </ul>
    </nav>
    @* Akhir Pagination *@
</section>

@section Scripts {
    <script type="text/javascript">
        $(function () {
            $('.badan-utama').css({
                'padding-left': '0',
                'padding-right': '0',
                'padding-top': '0rem',
            });
            $('.main-navbar').css({
                'position': 'fixed',
                'box-shadow': '4px 4px 4px rgba(0, 0, 0, 0.3)',
                'background-color': 'var(--primary-clr)',
            });
        });

        $('#@(nameof(Model.Bulan))').on('change', function () {
            const bulan = $(this).val();
            $('#search input#bulan').val(bulan);
        })

        $('#@(nameof(Model.Tahun))').on('change', function () {
            const tahun = $(this).val();
            $('#search input#tahun').val(tahun);
        })

        function openModal() {
            document.getElementById("filterModal").style.display = "block";

        }

        function closeModal() {
            document.getElementById("filterModal").style.display = "none";

        }

        window.onclick = function (event) {
            if (event.target == document.getElementById("filterModal")) {
                closeModal();
            }
        }
    </script>
}
