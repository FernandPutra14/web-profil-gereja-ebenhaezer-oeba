@using System.Globalization
@model Pengumuman
@{
    ViewData["Title"] = "Pengumuman";
    var cultureInfo = new CultureInfo("id-ID");
}

<section id="blog-container">
    <div class="blogs">
        <div class="post">
            @if (Model.Foto is not null)
            {
                <img src="@Url.Action("Index", "Foto", new {Area = "", id = Model.Foto.Id})" />
            }
            else
            {
                <img src="~/img/gereja1.jpg" />
            }
            <h3>@Model.Judul</h3>
            <div class="info-blog">
                @if (Model.Pembuat is not null)
                {
                    <h4>Oleh : @Model.Pembuat.UserName</h4>
                    <h4>@Model.TanggalDiBuat.ToString(cultureInfo.DateTimeFormat.LongDatePattern, cultureInfo)
                        @Model.TanggalDiBuat.ToString("h:mm tt" , cultureInfo)</h4>
                }
            </div>
            <p>@Model.Isi</p>
            <div class="dokumen">
                @if (Model.HaveDocument)
                {
                    <a class="btn" asp-action="Dokumen" asp-route-id="@Model.Id">Lihat Dokumen</a>
                }
            </div>         
        </div>
    </div>
</section>

<script type="text/javascript">
    $(function () {
        $('.main-navbar').css({
            'position': 'fixed',
            'box-shadow': '4px 4px 4px rgba(0, 0, 0, 0.3)',
            'background-color': 'var(--primary-clr)',
        });
    });
</script>




