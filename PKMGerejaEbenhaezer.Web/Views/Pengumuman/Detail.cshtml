@using System.Globalization
@model Pengumuman
@{
    ViewData["Title"] = "Pengumuman";
    var cultureInfo = new CultureInfo("id-ID");
}

<!-- Content Detail Pengumuman Section -->
<section id="blog-container">
    <div class="blogs">
        <div class="post">
            <!-- Foto -->
            @if (Model.Foto is not null)
            {
                <partial name="_PictureFotoPartial" model=@((Model.Foto.Id, "")) />
            }
            else
            {
                <img src="~/img/gereja1.jpg" />
            }
            <!-- Judul -->
            <h3 class="mb-3">@Model.Judul</h3>
            <div class="info-blog">
                @if (Model.Pembuat is not null)
                {
                    <!-- Penulis -->
                    <h4>Penulis : @Model.Pembuat.UserName</h4>
                    <!-- Tanggal Dibuat -->
                    <h4>
                        @Model.TanggalDiBuat.ToString(cultureInfo.DateTimeFormat.LongDatePattern, cultureInfo)
                        @Model.TanggalDiBuat.ToString("h:mm tt", cultureInfo)
                    </h4>                                    
                }
            </div>
            <!-- Isi pengumuman -->
            <p>@Html.Raw(Model.Isi)</p>
            <!-- Dokumen PDF (Jika Ada) -->
            <div class="dokumen">
                @if (Model.HaveDocument)
                {
                    <a class="btn" asp-action="Dokumen" asp-route-id="@Model.Id">Lihat Dokumen</a>
                }
            </div>         
        </div>
    </div>
</section>
<!-- Akhir Content Detail Pengumuman Section -->


<!-- Script JS -->
@section Scripts {
    <partial name="_NonTransparantNavbarPartial" />
}