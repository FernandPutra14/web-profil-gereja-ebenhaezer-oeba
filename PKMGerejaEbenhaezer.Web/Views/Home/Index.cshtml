@using PKMGerejaEbenhaezer.Web.Models.Home
@model IndexVM
@{
    ViewData["Title"] = "Home Page";
    var cultureInfo = new System.Globalization.CultureInfo("id-ID");
}

<!-- Hero Section -->
<section id="hero">
    <h1 data-aos="fade-up">Selamat Datang</h1>
</section>
<!-- Akhir Hero Section -->


<!-- Sejarah Section -->
<section id="sejarah">
    <div class="row-container">
        <div class="image-container">
            <img src="~/img/background_gereja_testing.jpg" alt="Gereja Image" />
        </div>
        <div class="content-sej">
            <h2>Sejarah GMIT Ebenhaezer Oeba Kupang</h2>
            <p>
                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
                Gravida in fermentum et sollicitudin ac orci phasellus egestas. Vestibulum morbi blandit cursus risus at. At in tellus integer
                feugiat.
            </p>
            <p>
                Turpis massa tincidunt dui ut ornare lectus sit.
                Sagittis id consectetur purus ut. Dignissim diam quis enim lobortis. Amet est placerat in egestas erat imperdiet
                sed euismod nisi. At imperdiet dui accumsan sit. Imperdiet nulla malesuada pellentesque elit eget gravida cum sociis natoque.
                Urna cursus eget nunc scelerisque viverra mauris in aliquam sem.
            </p>
        </div>
    </div>
</section>
<!-- Akhir Sejarah Section -->


<!-- Pendeta Section -->
<section id="pendeta">
    <h1>Pendeta GMIT Ebenhaezer Oeba</h1>
    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit aliqua.</p>
    <div class="pendeta-box">
        <div class="owl-carousel owl-theme fernand">

            @foreach (var pendeta in Model.DaftarPendeta)
            {
                <div class="profile">
                    <div class="gambar-pen">
                        @if (pendeta.Foto is not null)
                        {
                            <img src="@Url.Action("Index", "Foto", new { Area = "", id = pendeta.Foto.Id})" />
                        }
                        else
                        {
                            <img src="~/img/generaluser.png" alt="" />
                        }
                    </div>
                    <h6>@pendeta.Nama</h6>
                    <p>Pendeta</p>
                    <div class="pen-link">
                        <a @(pendeta.FacebookProfileLink is not null ?
                            $"href={pendeta.FacebookProfileLink.AbsoluteUri}" : "")>
                            <i class="ri-facebook-fill"></i>
                        </a>

                        <a @(pendeta.InstagramProfileLink is not null ?
                            $"href={pendeta.InstagramProfileLink.AbsoluteUri}" : "")>
                            <i class="ri-instagram-fill"></i>
                        </a>

                        <a @(pendeta.YoutubeProfileLink is not null ?
                            $"href={pendeta.YoutubeProfileLink.AbsoluteUri}" : "")>
                            <i class="ri-youtube-fill"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Akhir Pendeta Section -->


<!-- Injil Section -->
<section id="injil">
    <div class="injil-text">
        <h6 class="mt-3">
            "Karena tidak ada seorangpun yang dapat meletakkan dasar lain dari pada dasar yang telah diletakkan, yaitu Yesus Kristus.
            Entahkah orang membangun di atas dasar ini dengan emas, perak, batu permata, kayu, rumput kering atau jerami,
            sekali kelak pekerjaan masing-masing orang akan nampak. Karena hari Tuhan akan menyatakannya, sebab ia akan nampak
            dengan api dan bagaimana pekerjaan masing-masing orang akan diuji oleh api itu."
        </h6>
        <p class="mt-4">( 1 Korintus 3:11-13 )</p>
    </div>
</section>
<!-- Akhir Injil Section -->


<!-- Char Jemaat Section -->
<section id="about-container">
    <!-- Char -->
    <div class="about-char">
        @{
            var chartModel = new ChartModel
            {
                Type = ChartType.Doughnut,
                Label = "Jemaat Gereja",
                Data = new Dictionary<string, double>
                {
                    {"Lansia", Model.TotalLansia},
                    {"Dewasa", Model.TotalDewasa},
                    {"Pemuda", Model.TotalPemuda},
                    {"Remaja", Model.TotalRemaja},
                    {"Anak", Model.TotalAnak},
                },
            };
        }

        <vc:chart chart-model=chartModel></vc:chart>
    </div>
    <!-- Akhir Char -->
    <div class="about-text">
        <h2>Jumlah Jemaat GMIT Ebenhaezer Oeba</h2>
        <p>
            Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod
            tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam,
            quis nostrud exercitation ullamco laboris.
        </p>
        <div class="counters">
            <div>
                <div class="=counter">
                    <h3><span data-count="@Model.TotalLansia">0</span></h3>
                    <h4>Lansia</h4>
                </div>
                <div class="=counter">
                    <h3><span data-count="@Model.TotalDewasa">0</span></h3>
                    <h4>Dewasa</h4>
                </div>
                <div class="=counter">
                    <h3><span data-count="@Model.TotalPemuda">0</span></h3>
                    <h4>Pemuda</h4>
                </div>
                <div class="=counter">
                    <h3><span data-count="@Model.TotalRemaja">0</span></h3>
                    <h4>Remaja</h4>
                </div>
                <div class="=counter">
                    <h3><span data-count="@Model.TotalAnak">0</span></h3>
                    <h4>Anak</h4>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Akhir Chart Section -->


<!-- Warta Section -->
<section class="warta">
    <!-- Header Warta Section -->
    <header class="section-header">
        <div class="header-text">
            <h1>Warta Jemaat</h1>
            <p>
                Lorem ipsum dolor sit amet, consectetur adipiscing elit,
                sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </p>
        </div>
        <a asp-action="Index" asp-controller="Pengumuman" class="warta-btn btn">Lihat Semua</a>
    </header>
    <!-- Akhir Header Warta Section -->
    <!-- Content Warta Section -->
    <div class="warta-contents">
        <div class="owl-carousel owl-theme fajar">
            @foreach (var warta in Model.DaftarWartaJemaat)
            {
                <!-- Ini Cardnya -->
                <div class="item warta-card">
                    <div class="image-wrapper">
                        <img src="~/img/default4_warta_jemaat.png" />
                        <div class="tanggal">
                            <div class="tanggal-text mb-1">
                                <h5></h5>
                                <h3>@warta.TanggalWarta.Day</h3>
                            </div>
                            <h4>@warta.TanggalWarta.ToString("MMMM, yyyy", cultureInfo)</h4>
                        </div>
                    </div>
                    <a href="@warta.DocumentLink.AbsoluteUri" class="tombolbaca">Baca Warta Jemaat</a>
                </div>
                <!-- Ini Akhir Cardnya -->
            }
        </div>
    </div>
    <!-- Akhir Content Warta Section -->
</section>
<!-- Akhir Warta Section -->


<!-- Pengumuman Section -->
<section class="peng mb-5">
    <!-- Header Pengumuman Section -->
    <header class="section-header">
        <div class="header-text">
            <h1>Pengumuman Gereja</h1>
            <p>
                Lorem ipsum dolor sit amet, consectetur adipiscing elit,
                sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </p>
        </div>
        <a asp-action="Index" asp-controller="Pengumuman" class="peng-btn btn">Lihat Semua</a>
    </header>
    <!-- Akhir Header Pengumuman Section -->
    <!-- Content Pengumuman Section -->
    <div class="peng-contents">
        <div class="owl-carousel owl-theme fajar">
            @if (Model.DaftarPengumuman != null || Model.DaftarPengumuman!.Count > 0)
            {
                @foreach (var pengumuman in Model.DaftarPengumuman.Take(3))
                {
                    <!-- Ini Cardnya -->
                    <div class="item peng-card">
                        @if (pengumuman.Foto != null)
                        {
                            <img src="@Url.Action("Index", "Foto", new {Area = "", id = pengumuman.Foto.Id})" />
                        }
                        else
                        {
                            <img src="~/img/gereja1.jpg" />
                        }
                        <div class="category">
                            <div class="subject">
                                <h3>Pengumuman</h3>
                            </div>
                        </div>
                        <h2 class="peng-title">@pengumuman.Judul</h2>
                        <p>@pengumuman.Isi</p>
                        <div class="peng-tanggal">
                            <span><i class="ri-calendar-fill"></i>@pengumuman.TanggalDiBuat.ToString(cultureInfo.DateTimeFormat.LongDatePattern, cultureInfo)</span>
                            <a asp-action="Detail" asp-controller="Pengumuman" asp-route-id="@pengumuman.Id" asp-area=""
                               class="tombolseleng">Baca Selengkapnya...</a>
                        </div>
                    </div>
                    <!-- Ini Akhir Cardnya -->
                }
            }
        </div>
    </div>
    <!-- Akhir Content Pengumuman Section -->
</section>
<!-- Akhir Pengumuman Section -->
@section Scripts {
    
    <script type="text/javascript" src="~/js/counter.js"></script>
    <script type="text/javascript" src="~/js/transisiNavbar.js"></script>

    <script type="text/javascript">
        $(function () {
            $('.badan-utama').css({
                'padding-left': '0',
                'padding-right': '0',
                'padding-top': '0rem',
            });
        });
    </script>
}