{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=gerejaEbenhaezer;Username=postgres;Password=user"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ImageCompression": {
    "CompressionQuality": 50,
    "Small": {
      "Width": 500,
      "Height": 500
    },
    "Medium": {
      "Width": 750,
      "Height": 750
    },
    "Large": {
      "Width": 1000,
      "Height": 1000
    }
  },
  "PhotoFileSettings": {
    "PermittedFileExtensions": [ ".jpeg", ".jpg" ],
    "MinSizeLimit": 40960, //40KB
    "MaxSizeLimit": 2097152, //2MB
    "FolderPath": "/img/"
  },
  "PDFFileSettings": {
    "FolderPath": "/pdf/",
    "MinSizeLimit": 10240, //10KB
    "MaxSizeLimit": 2097152 //2MB
  },
  "AllowedHosts": "*"
}