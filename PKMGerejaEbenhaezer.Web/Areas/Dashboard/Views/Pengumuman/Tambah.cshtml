@using PKMGerejaEbenhaezer.Web.Areas.Dashboard.Models.Pengumuman
@model TambahVM
@{
    ViewData["Title"] = "Tambah Pengumuman";
}

<div class="pluspeng">


    <!-- Hyperlink -->
    <h1 class="title">Tambah Pengumuman</h1>
    <ul class="breadcrumbs mb-4">
        <li><a asp-action="Index">Pengumuman</a></li>
        <li class="divider">/</li>
        <li><a href="#" class="active">Tambah Pengumuman</a></li>
    </ul>
    <!-- Akhir Hyperlink -->


    <!-- Container Input dan Tombol Simpan -->
    <div class="container-fluid cardplus">
        <form asp-action="Tambah" method="post" class="container" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="form-text text-danger"></div>

            <div class="row mb-3 justify-content-center align-items-center">
                <div id="dvPreview" class="d-flex justify-content-center align-items-stretch">
                    <div class="d-flex justify-content-center align-items-center flex-grow-1">
                        <h2>Foto Pengumuman</h2>
                    </div>
                </div>
            </div>

            <div style="display:flex; justify-content: center; align-items: center;">
                <vc:upload-foto id-foto="null"></vc:upload-foto>
            </div>
            
            <div class="row">
                <span asp-validation-for="@Model.IdFoto" class="text-danger form-text"></span>
            </div>

            <div class="row mb-3">
                <div class="col-12 mt-4 input-box">
                    <label asp-for="@Model.Judul" class="form-label"></label>
                    <input type="text" asp-for="@Model.Judul" class="form-control" placeholder="Isi Judul Pengumuman" />
                    <span class="form-text text-danger" asp-validation-for="@Model.Judul"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12 input-box">
                    <label asp-for="@Model.Isi" class="form-label"></label>
                    <textarea type="text" asp-for="@Model.Isi" class="form-control" cols="10" rows="10"></textarea>
                    <span class="form-text text-danger" asp-validation-for="@Model.Isi"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12 check-box">
                    <input id="haveDocument" type="checkbox" asp-for="@Model.HaveDocument" class="form-check-input"></input>
                    <label asp-for="@Model.HaveDocument" class="form-check-label"></label>
                    <span class="form-text text-danger" asp-validation-for="@Model.HaveDocument"></span>
                </div>
            </div>

            <div id="document" class="row mb-3" @(Model.HaveDocument ? "" : "hidden")>
                <div class="col-12 box">
                    <label asp-for="@Model.PDFFormFile" class="form-label"></label>
                    <input type="file" asp-for="@Model.PDFFormFile" class="form-control"></input>
                    <span class="form-text text-danger" asp-validation-for="@Model.PDFFormFile"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col d-flex justify-content-end mt-4">
                    <a class="btndel me-2" asp-action="Index" asp-controller="Pengumuman" asp-area="Dashboard">Batal</a>
                    <button type="submit" class="btn">Simpan</button>                   
                </div>
            </div>
        </form>
    </div>
    <!-- Akhir Container Input dan Tombol Simpan -->


</div>


<!-- Script JS -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script type="text/javascript">
        $(function () {
            $('#haveDocument').on('change', function () {
                const value = $(this).prop('checked');

                $('#document').prop('hidden', !value);
            });
        })
    </script>
}