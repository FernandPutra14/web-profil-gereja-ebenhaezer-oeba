@using Humanizer
@using Microsoft.EntityFrameworkCore
@using PKMGerejaEbenhaezer.DataAccess.Data
@using System.Globalization
@inject AppDbContext AppDbContext
@model TambahVM
@{
    ViewData["Title"] = "Tambah Ibadah";
    var cultureInfo = new CultureInfo("id-ID");
    var daftarKategori = await AppDbContext.KategoriIbadahTable.ToListAsync();
    var daftarPendeta = await AppDbContext.PendetaTable.ToListAsync();
}


<div class="tambadah">


    <!-- Hyperlink -->
    <h1 class="title">Tambah Ibadah Mingguan</h1>
    <ul class="breadcrumbs mb-4">
        <li><a asp-action="Index">Ibadah Mingguan</a></li>
        <li class="divider">/</li>
        <li><a href="#" class="active">Tambah Ibadah Mingguan</a></li>
    </ul>
    <!-- Akhir Hyperlink -->


    <!-- Container Input dan Tombol Simpan -->
    <div class="container-fluid cardplus">
        <form asp-action="Tambah">
            <div asp-validation-summary="ModelOnly" class="form-text text-danger"></div>

            <div class="row mb-3">
                <div class="col-12 input-box">
                    <label asp-for="@Model.Judul" class="form-label"></label>
                    <input asp-for="@Model.Judul" class="form-control" />
                    <span asp-validation-for="@Model.Judul" class="form-text text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6 col-12 input-box">
                    <label asp-for="@Model.NasPembimbing" class="form-label">Nats Pembimbing</label>
                    <input asp-for="@Model.NasPembimbing" placeholder="Contoh: Markus 3:4,15 atau Markus 3:4-15" class="form-control" />
                    <span asp-validation-for="@Model.NasPembimbing" class="form-text text-danger"></span>
                </div>
                <div class="col-md-6 col-12 input-box">
                    <label asp-for="@Model.Renungan" class="form-label">Nats Renungan</label>
                    <input asp-for="@Model.Renungan" placeholder="Contoh: Markus 3:4,15 atau Markus 3:4-15" class="form-control" />
                    <span asp-validation-for="@Model.Renungan" class="form-text text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6 col-12 input-box">
                    <label asp-for="@Model.TanggalIbadah" class="form-label"></label>
                    <input asp-for="@Model.TanggalIbadah" class="form-control" value="" />
                    <span asp-validation-for="@Model.TanggalIbadah" class="form-text text-danger"></span>
                </div>
                <div class="col-md-6 col-12 input-box">
                    <label asp-for="@Model.Tempat" class="form-label"></label>
                    <input asp-for="@Model.Tempat" placeholder="Contoh: Gedung Gereja Ebenhaezer Oeba" class="form-control" />
                    <span asp-validation-for="@Model.Tempat" class="form-text text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6 col-12 input-box">
                    <label asp-for="@Model.IdKategoriIbadah" class="form-label"></label>
                    <select asp-for="@Model.IdKategoriIbadah" class="form-control">
                        @foreach (var item in daftarKategori)
                        {
                            <option value="@item.Id">@item.Nama -- @item.Durasi.Humanize(culture: cultureInfo)</option>
                        }
                    </select>
                    <span asp-validation-for="@Model.IdKategoriIbadah" class="form-text text-danger"></span>
                </div>
                <div class="col-md-6 col-12 input-box">
                    <label asp-for="@Model.IdPendeta" class="form-label"></label>
                    <select asp-for="@Model.IdPendeta" class="form-control">
                        @foreach (var item in daftarPendeta)
                        {
                            <option value="@item.Id">@item.Nama</option>
                        }
                    </select>
                    <span asp-validation-for="@Model.IdPendeta" class="form-text text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12 input-box">
                    <label asp-for="@Model.Deskripsi" class="form-label"></label>
                    <textarea asp-for="@Model.Deskripsi" class="form-control" rows="7"></textarea>
                    <span asp-validation-for="@Model.Deskripsi" class="form-text text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col d-flex justify-content-start mt-4">
                    <button type="submit" class="btn me-2">Simpan</button>
                    <a class="btndel" asp-action="Index" asp-controller="Ibadah" asp-area="Dashboard">Batal</a>
                </div>
            </div>
        </form>
    </div>
    <!-- Akhir Container Input dan Tombol Simpan -->


</div>


<!-- Script JS -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}