@using PKMGerejaEbenhaezer.Web.Areas.Dashboard.Models.Ibadah
@model TambahKategoriVM
@{
    ViewData["Title"] = "Tambah Kategori";
}

<form asp-action="TambahKategori">
    <div class="row">
        <div class="col">
            <label asp-for="@Model.Nama" class="form-label"></label>
            <input asp-for="@Model.Nama" class="form-control" />
            <span asp-validation-for="@Model.Nama" class="form-text text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            Durasi
        </div>
        
        <div class="col-12">
            <span asp-validation-for="@Model.Durasi" class="form-text text-danger text-center"></span>
        </div>

        <div class="col-6">
            <label asp-for="@Model.TotalJam" class="form-label"></label>
            <input asp-for="@Model.TotalJam" class="form-control" />
            <span asp-validation-for="@Model.TotalJam" class="form-text text-danger"></span>
        </div>

        <div class="col-6">
            <label asp-for="@Model.TotalMenit" class="form-label"></label>
            <input asp-for="@Model.TotalMenit" class="form-control" />
            <span asp-validation-for="@Model.TotalMenit" class="form-text text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <button type="submit" class="btn btn-primary">Simpan</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}