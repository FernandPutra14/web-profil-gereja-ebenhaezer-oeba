@using PKMGerejaEbenhaezer.Web.Areas.Dashboard.Models.Pendeta
@model EditVM
@{
    ViewData["Title"] = "Tambah Pendeta";
}

<div class="edpend">


    <!-- Hyperlink -->
    <h1 class="title">Edit Pendeta</h1>
    <ul class="breadcrumbs mb-4">
        <li><a asp-action="Index">Pendeta</a></li>
        <li class="divider">/</li>
        <li><a href="#" class="active">Edit Pendeta</a></li>
    </ul>
    <!-- Akhir Hyperlink -->


    <!-- Container Edit dan Tombol Simpan -->
    <div class="container-fluid cardplus">
        <form asp-action="Edit" method="post" class="container" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="form-text text-danger"></div>

            <input hidden asp-for="@Model.Id" />

            <div class="row">
                <vc:foto-picker input-name=@nameof(EditVM.IdFoto) 
                    multi=false values=@(Model.IdFoto is null ? null : new int[] { Model.IdFoto.Value })>
                </vc:foto-picker>
                <span asp-validation-for="@Model.IdFoto"></span>
            </div>         

            <div class="row mb-3">
                <div class="col-12 mt-4 mb-3 input-box">
                    <label asp-for="@Model.Nama" class="form-label"></label>
                    <input type="text" asp-for="@Model.Nama" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.Nama"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12 mt-4 mb-3 input-box">
                    <label asp-for="@Model.Jabatan" class="form-label"></label>
                    <input type="text" asp-for="@Model.Jabatan" class="form-control" />
                    @* <span class="form-text text-danger" asp-validation-for="@Model.jabatan"></span> *@
                </div>
            </div>

            <div class="row mb-5">
                <label class="form-label">Akun Media Sosial (Opsional)</label>
                <div class="col-md-4 col-12 input-box">
                    <label asp-for="@Model.FacebookProfileLink" class="form-label"></label>
                    <input type="text" asp-for="@Model.FacebookProfileLink" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.FacebookProfileLink"></span>
                </div>
                <div class="col-md-4 col-12 input-box">
                    <label asp-for="@Model.InstagramProfileLink" class="form-label"></label>
                    <input type="text" asp-for="@Model.InstagramProfileLink" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.InstagramProfileLink"></span>
                </div>
                <div class="col-md-4 col-12 input-box">
                    <label asp-for="@Model.YoutubeProfileLink" class="form-label"></label>
                    <input type="text" asp-for="@Model.YoutubeProfileLink" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.YoutubeProfileLink"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col d-flex justify-content-start mt-4">
                    <button type="submit" class="btn me-2">Simpan</button>
                    <a class="btndel" asp-action="Index" asp-controller="Pendeta" asp-area="Dashboard">Batal</a>
                </div>
            </div>
        </form>
    </div>
    <!-- Akhir Container Edit dan Tombol Simpan -->


</div>


<!-- Script JS -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}