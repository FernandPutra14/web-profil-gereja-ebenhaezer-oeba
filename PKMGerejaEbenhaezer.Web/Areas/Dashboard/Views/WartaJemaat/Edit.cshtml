@using PKMGerejaEbenhaezer.Web.Areas.Dashboard.Models.WartaJemaat
@using System.Globalization
@model EditVM
@{
    ViewData["Title"] = "Edit Warta Jemaat";
    var cultureInfo = new CultureInfo("id-ID");
}

<div class="edwarta">
    <h1 class="title">Edit Warta Jemaat</h1>
    <ul class="breadcrumbs mb-4">
        <li><a href="#">Daftar Warta Jemaat</a></li>
        <li class="divider">/</li>
        <li><a href="#" class="active">Edit Warta Jemaat</a></li>
    </ul>
    <div class="container-fluid cardplus">
        <form asp-action="Edit" class="container">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input hidden asp-for="@Model.Id" />

            <div class="row">
                <div class="col-12 mb-3 input-box">
                    <label asp-for="@Model.TanggalWarta" class="form-label"></label>
                    <input asp-for="@Model.TanggalWarta" type="date" value="@Model.TanggalWarta.ToString("yyyy-MM-dd")" class="form-control" />
                    <span asp-validation-for="@Model.TanggalWarta" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-4 input-box">
                    <label asp-for="@Model.DocumentLink" class="form-label"></label>
                    <input asp-for="@Model.DocumentLink" id="documentLink" type="text" class="form-control" />
                    <span asp-validation-for="@Model.DocumentLink" class="form-text text-danger"></span>
                    <button type="button" id="authorize_button" onclick="handleAuthClick()" class="btn btn-primary">
                        Pilih/Upload dari Google Drive
                    </button>
                </div>
            </div>

            <div class="row">
                <button type="submit" class="btn btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <partial name="_GoogleDrivePickerApiScriptsPartial" />
}