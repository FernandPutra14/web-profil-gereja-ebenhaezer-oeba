@using PKMGerejaEbenhaezer.Web.Areas.Dashboard.Models.WartaJemaat
@using System.Globalization
@model TambahVM
@{
    ViewData["Title"] = "Tambah Warta Jemaat";
    var cultureInfo = new CultureInfo("id-ID");
}

<div class="tamwarta">


    <!-- Hyperlink -->
    <h1 class="title">Tambah Warta Jemaat</h1>
    <ul class="breadcrumbs mb-4">
        <li><a asp-action="Index">Warta Jemaat</a></li>
        <li class="divider">/</li>
        <li><a href="#" class="active">Tambah Warta Jemaat</a></li>
    </ul>
    <!-- Akhir Hyperlink -->


    <!-- Container Input dan Tombol Simpan -->
    <div class="container-fluid cardplus">
        <form asp-action="Tambah" class="container">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-12 mb-3 input-box">
                    <label asp-for="@Model.TanggalWarta" class="form-label"></label>
                    <input asp-for="@Model.TanggalWarta" type="date" class="form-control" />
                    <span asp-validation-for="@Model.TanggalWarta" class="text-danger"></span>
                </div>
            </div>

            <button type="button" id="authorize_button" onclick="handleAuthClick()" class="btn mb-2">
                Pilih/Upload dari Google Drive
            </button>

            <div class="row">
                <div class="col-12 input-box">
                    <label asp-for="@Model.DocumentLink" class="form-label"></label>
                    <input asp-for="@Model.DocumentLink" type="text" class="form-control" placeholder="Link Google Drive" />
                    <p class="form-text">
                        Copy link file warta dari google drive ke sini
                    </p>
                    <span asp-validation-for="@Model.DocumentLink" class="form-text text-danger"></span>
                    
                </div>
            </div>


            <div class="row mb-3">
                <div class="col d-flex justify-content-start mt-4">
                    <button type="submit" class="btn me-2">Simpan</button>
                    <a class="btndel" asp-action="Index" asp-controller="WartaJemaat" asp-area="Dashboard">Batal</a>
                </div>
            </div>
        </form>
    </div>
    <!-- Akhir Container Input dan Tombol Simpan -->


</div>


<!-- Script JS -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <partial name="_GoogleDrivePickerApiScriptsPartial" />
}