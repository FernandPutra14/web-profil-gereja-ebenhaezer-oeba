@using PKMGerejaEbenhaezer.Web.Areas.Dashboard.Models.Rayon
@model EditVM
@{
    ViewData["Title"] = "Tambah Rayon";
}

<div class="editray">


    <!-- Hyperlink -->
    <h1 class="title">Edit Rayon</h1>
    <ul class="breadcrumbs mb-4">
        <li><a asp-action="Index">Rayon</a></li>
        <li class="divider">/</li>
        <li><a href="#" class="active">Edit Rayon</a></li>
    </ul>
    <!-- Akhir Hyperlink -->
    <!-- Container Edit dan Tombol Simpan -->
    <div class="container-fluid cardedit">
        <form asp-action="Edit" method="post" class="container" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="form-text text-danger"></div>

            <div style="display:flex; justify-content: center; align-items: center;">
                <vc:foto-picker input-name=@nameof(EditVM.IdFoto) multi=false
                                values=@(Model.IdFoto is null ? null : new int[] { Model.IdFoto.Value })>
                </vc:foto-picker>
            </div>

            <div class="row mb-3">
                <div class="col-12 mt-4 input-box">
                    <label asp-for="@Model.Nama" class="form-label"></label>
                    <input type="text" asp-for="@Model.Nama" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.Nama"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12 mb-3 input-box">
                    <label asp-for="@Model.KetuaRayon" class="form-label"></label>
                    <input type="text" asp-for="@Model.KetuaRayon" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.KetuaRayon"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="form-label">Opsional</label>
                <div class="col-12 mb-3 input-box">
                    <label asp-for="@Model.NomorWa" class="form-label"></label>
                    <input type="text" asp-for="@Model.NomorWa" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.NomorWa"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="form-label">Jumlah Jemaat Berdasarkan Jenis Kelamin</label>
                <div class="col-md-6 col-12 input-box">
                    <label asp-for="@Model.JumlahLakiLaki" class="form-label"></label>
                    <input type="number" asp-for="@Model.JumlahLakiLaki" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.JumlahLakiLaki"></span>
                </div>
                <div class="col-md-6 col-12 input-box">
                    <label asp-for="@Model.JumlahPerempuan" class="form-label"></label>
                    <input type="number" asp-for="@Model.JumlahPerempuan" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.JumlahPerempuan"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="form-label">Jumlah Jemaat Berdasarkan Usia</label>
                <div class="col-md col-12 input-box">
                    <label asp-for="@Model.JumlahAnak" class="form-label"></label>
                    <input type="number" asp-for="@Model.JumlahAnak" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.JumlahAnak"></span>
                </div>
                <div class="col-md col-12 input-box">
                    <label asp-for="@Model.JumlahRemaja" class="form-label"></label>
                    <input type="number" asp-for="@Model.JumlahRemaja" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.JumlahRemaja"></span>
                </div>
                <div class="col-md col-12 input-box">
                    <label asp-for="@Model.JumlahPemuda" class="form-label"></label>
                    <input type="number" asp-for="@Model.JumlahPemuda" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.JumlahPemuda"></span>
                </div>
                <div class="col-md col-12 input-box">
                    <label asp-for="@Model.JumlahDewasa" class="form-label"></label>
                    <input type="number" asp-for="@Model.JumlahDewasa" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.JumlahDewasa"></span>
                </div>
                <div class="col-md col-12 input-box mb-5">
                    <label asp-for="@Model.JumlahLansia" class="form-label"></label>
                    <input type="number" asp-for="@Model.JumlahLansia" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="@Model.JumlahLansia"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col d-flex justify-content-start mt-4">
                    <button type="submit" class="btn me-2">Simpan</button>
                    <a class="btndel" asp-action="Index" asp-controller="Rayon" asp-area="Dashboard">Batal</a>
                </div>
            </div>
        </form>
    </div>
    <!-- Akhir Container Edit dan Tombol Simpan -->


</div>


<!-- Script JS -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}