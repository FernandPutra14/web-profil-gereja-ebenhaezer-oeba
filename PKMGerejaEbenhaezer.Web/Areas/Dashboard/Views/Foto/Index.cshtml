@using PKMGerejaEbenhaezer.Web.Areas.Dashboard.Models.FotoModels
@using PKMGerejaEbenhaezer.Web.Utlities
@using System.Globalization
@model IndexVM
@{
    ViewData["Title"] = "Daftar Foto";
    var cultureInfo = new CultureInfo("id-ID");
}

<div class="fotoo">

    <!-- Hyperlink -->
    <h1 class="title">Galeri</h1>
    <ul class="breadcrumbs mb-4">
        <li><a href="#">Informasi & Media</a></li>
        <li class="divider">/</li>
        <li><a href="#" class="active">Galeri</a></li>
    </ul>
    <!-- Akhir Hyperlink -->
    <!-- Form Upload Foto -->
    <form asp-action="IndexPOST" class="row mb-5" method="post" enctype="multipart/form-data" asp-route-pIndex="@Model.Items!.PageIndex">
        <div class="col-md-12 mb-3">
            <input class="form-control" type="file" asp-for="@Model.FormFile" style="font-size: 15px; margin-top: 0px;" />
            <span asp-validation-for="@Model.FormFile" class="text-danger"></span>
        </div>
        <div class="col-md-12 d-flex justify-content-start">
            <button class="btn" style="padding: 8px 100px;" type="submit">Upload</button>
        </div>
    </form>
    <!-- Akhir Form Upload Foto -->
    <!-- Content Galeri -->
    <div class="grid-wrapper">
        @foreach (var foto in Model.Items!)
        {
            <div>
                <a data-fancybox="gallery" href="@Url.Action("Index", "Foto", new { Area = "", id = foto.Id })"
                   data-id="@foto.Id"
                   data-caption="
                   Pengunggah : @foto.Pembuat?.UserName <br> Waktu diunggah : @foto.TanggalDiBuat.ToString(cultureInfo.DateTimeFormat.LongDatePattern, cultureInfo)
                @foto.TanggalDiBuat.ToString(cultureInfo.DateTimeFormat.ShortTimePattern, cultureInfo)  "  >
                        <img src="@Url.Action("Index", "Foto", new { Area = "", id = foto.Id })" />
                    </a>
            </div>
        }
    </div>
    <!-- Akhir Content Galeri -->
    <!-- Konfirmasi Hapus Modal-->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true" style="z-index:99999;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Hapus Foto</h5>
                </div>
                <div class="modal-body">Apakah anda yakin ingin menghapus foto ini?</div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-bs-dismiss="modal">Batal</button>
                    <form asp-action="Hapus" method="post">
                        <input hidden name="id" id="id"/>
                        <button type="submit" class="btn">Hapus</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- Akhir Konfirmasi Hapus Modal-->
    <!-- Pagination -->
    <div class="row mt-5">
        @{
            var hasPrevious = Model.Items.HasPreviousPage;
            var hasNext = Model.Items.HasNextPage;
        }

        <div class="col-6">
            <a asp-action="Index" asp-route-pageIndex="@(Model.Items.PageIndex - 1)" asp-area="Dashboard" class="btn w-100 @(hasPrevious ? "" : " disabled")">Sebelumnya</a>
        </div>
        <div class="col-6">
            <a asp-action="Index" asp-route-pageIndex="@(Model.Items.PageIndex + 1)" asp-area="Dashboard" class="btn w-100 @(hasNext ? "" : " disabled")">Selanjutnya</a>
        </div>
    </div>
    <!-- Akhir Pagination -->


</div>


<!-- Script JS -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_FancyBoxPartial" />

    <script>
        function hideImg() {
            document.getElementById("HideImg")
                .style.display = "none";
        }
    </script>

    <script type="text/javascript">
        $(function () {
            $.fancybox.defaults.buttons = [
                'slideShow',
                'share',
                'zoom',
                'fullScreen',
                'download',
                'thumbs',
                'delete',
                'close',
            ];

            $.fancybox.defaults.btnTpl.delete = '<button data-fancybox-delete class="fancybox-button fancybox-button--delete" title="Delete"><i class="fa fa-trash" style="font-size:16px; padding-top:3px;"></i></button>';

            // CLick tombol Delete
            $(document).on('click', '[data-fancybox-delete]', function () {
                var instance = $.fancybox.getInstance();
                var current = instance.current;
                var fotoId = $(current.opts.$orig).data('id');

                console.log(fotoId);

                //Memperlihatkan konfirmasi modal
                $('#deleteModal input#id').val(fotoId);
                $('#deleteModal').modal('show');
            });

            //Inisialisasi Fancybox dengan custom tombol hapus
            $('[data-fancybox="gallery"]').fancybox();
        });
    </script>
}