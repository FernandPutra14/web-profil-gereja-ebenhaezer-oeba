@using Humanizer
@using PKMGerejaEbenhaezer.Web.Areas.Dashboard.Models.KategoriIbadah
@model TambahVM
@{
    ViewData["Title"] = "Tambah Kategori";
}

<div class="tamkatibd">


    <!-- Hyperlink -->
    <h1 class="title">Tambah Kategori Ibadah</h1>
    <ul class="breadcrumbs mb-4">
        <li><a asp-action="Index">Kategori Ibadah</a></li>
        <li class="divider">/</li>
        <li><a href="#" class="active">Tambah Kategori Ibadah</a></li>
    </ul>
    <!-- Akhir Hyperlink -->


    <!-- Container Input dan Tombol Simpan -->
    <div class="container-fluid cardplus">
        <form asp-action="Tambah">
            <div asp-validation-summary="ModelOnly" class="text-danger form-text"></div>

            <div class="row">
                <div class="col input-box">
                    <label asp-for="@Model.Nama" class="form-label"></label>
                    <input asp-for="@Model.Nama" class="form-control" />
                    <span asp-validation-for="@Model.Nama" class="form-text text-danger"></span>
                </div>
            </div>


            <div class="row input-box mt-3">
                <label asp-for="@Model.WarnaArgb" class="form-label"></label>
                <div class="filterbut">
                    <input hidden asp-for="@Model.WarnaArgb" />
                    @foreach (var color in KategoriColors.Colors)
                    {
                        <a href="#">
                            <input hidden id="value" value="@color.ToArgb()" />
                            <div class="color-box" style="background-color:rgb(@color.R, @color.G, @color.B)">
                            </div>
                        </a>
                    }
                </div>
                <span asp-validation-for="@Model.WarnaArgb" class="form-text text-danger"></span>
            </div>


            

            <div class="row mt-4">
                <label class="form-label">Durasi</label>

                <div class="col-12 input-box">
                    <span asp-validation-for="@Model.Durasi" class="form-text text-danger text-center"></span>
                </div>

                <div class="col-6 input-box">
                    <label asp-for="@Model.TotalJam" class="form-label"></label>
                    <input asp-for="@Model.TotalJam" class="form-control" />
                    <span asp-validation-for="@Model.TotalJam" class="form-text text-danger"></span>
                </div>

                <div class="col-6 input-box">
                    <label asp-for="@Model.TotalMenit" class="form-label"></label>
                    <input asp-for="@Model.TotalMenit" class="form-control" />
                    <span asp-validation-for="@Model.TotalMenit" class="form-text text-danger"></span>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col">
                    <button type="submit" class="btn" style="width:100%;">Simpan</button>
                </div>
            </div>
        </form>
    </div>
    <!-- Akhir Container Input dan Tombol Simpan -->


</div>



<!-- Script JS -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script type="text/javascript">
        const inputWarna = $('#@(nameof(TambahVM.WarnaArgb))');

        const daftarWarna = $('.filterbut>a');

        const init = () => {
            const inputWarnaVal = inputWarna.val();
            daftarWarna.each((index, item) => {
                const value = $(item).find('input#value').val();

                if (value === inputWarnaVal) {
                    $(item).addClass('active');
                    return;
                }
            })
        };

        const updateUI = (itemIndex) => {
            daftarWarna.each((index, item) => {
                if(index === itemIndex){
                    $(item).addClass('active');
                } else {
                    $(item).removeClass('active');
                }
            })
        }

        init();

        daftarWarna.each((index, item) => {
            $(item).on('click', function () {
                const value = $(item).find('input#value').val();
                inputWarna.val(value);

                updateUI(index);
            });
        });
    </script>
}