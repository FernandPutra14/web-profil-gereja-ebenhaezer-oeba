@using Humanizer
@using System.Globalization
@model List<KategoriIbadah>
@{
    ViewData["Title"] = "Kategori Ibadah";
    var cultureInfo = new CultureInfo("id-ID");
}

<div class="katibadah">


    <!-- Hyperlink -->
    <h1 class="title">Kategori Ibadah</h1>
    <ul class="breadcrumbs mb-4">
        <li><a>Ibadah & Kegiatan</a></li>
        <li class="divider">/</li>
        <li><a class="active">kategori Ibadah</a></li>
    </ul>
    <!-- Akhir Hyperlink -->


    <!-- Tombol Tambah kategori Ibadah -->
    <div class="mb-4 mt-4">
        <a style="width:320px;" class="btn" asp-action="Tambah"> + Tambah Kategori Ibadah</a>
    </div>
    <!-- Akhir Tombol Tambah kategori Ibadah -->


    <!-- Container Tabel Daftar -->
    <div class="container">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nama</th>
                    <th>Durasi</th>
                    <th>Aksi</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nama</td>
                        <td>@item.Durasi.Humanize(culture: cultureInfo)</td>
                        <td>
                            <div class="d-flex gap-1 justify-content-start align-items-center">
                                <a class="btn" asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="fas fa-pen-square"></i>
                                </a>
                                <!-- Button trigger modal -->
                                <a class="btndel" data-bs-toggle="modal" data-bs-target="#exampleModal@(item.Id)">
                                    <i class="fa fa-regular fa-trash"></i>
                                </a>

                                @{
                                    var modalVM = new DeleteConfirmationModalVM()
                                    {
                                        ModalId = $"exampleModal{item.Id}",
                                        ModalTitle = "Hapus Kategori Ibadah",
                                        FormAction = Url.Action("Hapus", "KategoriIbadah", new { Area = "Dashboard", id = item.Id })!,
                                    };
                                }

                                <partial name="_DeleteConfirmationModalPartial" model="modalVM" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- Akhir Container Tabel Daftar -->


</div>


<!-- Script JS -->
@section Scripts {
    <partial name="_DataTablePartial" />
}