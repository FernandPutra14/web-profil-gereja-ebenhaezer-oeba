@using PKMGerejaEbenhaezer.Web.Areas.Dashboard.Models.Account
@model UbahPasswordVM
@{
    ViewData["Title"] = "Ubah Password";
}

<div class="container">
    <form asp-action="UbahPassword">
        <div asp-validation-summary="ModelOnly" class="form-text text-danger"></div>

        <div class="row">
            <div class="col-12">
                <label asp-for="@Model.Password" class="form-label"></label>
                <input asp-for="@Model.Password" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="@Model.Password" class="form-text text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <label asp-for="@Model.PasswordConfirmation" class="form-label"></label>
                <input asp-for="@Model.PasswordConfirmation" type="password" class="form-control" />
                <span asp-validation-for="@Model.PasswordConfirmation" class="form-text text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Simpan</button>
                <p class="form-text">Setelah password berhasil diubah anda akan log out dan diarahkan ke halaman login untuk login dengan password baru.</p>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}