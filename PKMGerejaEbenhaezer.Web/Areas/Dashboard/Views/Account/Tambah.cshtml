@using PKMGerejaEbenhaezer.Web.Areas.Dashboard.Models.Account
@model TambahVM
@{
    ViewData["Title"] = "Tambah Akun";
}

<div class="container">
    <form asp-action="Tambah" method="post">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="row">
            <div class="col-12">
                <label asp-for="@Model.UserName" class="form-label"></label>
                <input asp-for="@Model.UserName" class="form-control" type="text"/>
                <span asp-validation-for="@Model.UserName" class="text-danger form-text"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <label asp-for="@Model.Password" class="form-label"></label>
                <input asp-for="@Model.Password" class="form-control" type="password" />
                <span asp-validation-for="@Model.Password" class=" text-danger form-text"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <label asp-for="@Model.PasswordConfirmation" class="form-label"></label>
                <input asp-for="@Model.PasswordConfirmation" class="form-control" type="password" />
                <span asp-validation-for="@Model.PasswordConfirmation" class=" text-danger form-text"></span>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}