@using System.Globalization
@model List<AppUser>
@{
    ViewData["Title"] = "Akun";
    var cultureInfo = new CultureInfo("id-ID");
}

<div class="akunn">
    <h1 class="title">Akun Admin</h1>
    <ul class="breadcrumbs mb-4">
        <li><a href="#">Informasi</a></li>
        <li class="divider">/</li>
        <li><a href="#" class="active">Akun Admin</a></li>
    </ul>
    <div class="mb-4 mt-4">
        <a style="" class="btn w-100" asp-area="Dashboard" asp-controller="Account" asp-action="Tambah"> + Tambah Akun</a>
    </div>
    <div class="container">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nama</th>
                    <th>Role</th>
                    <th>Terakhir Berubah</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appUser in Model)
                {
                    <tr>
                        <td>@appUser.Id</td>
                        <td>@appUser.UserName</td>
                        <td>@appUser.Role</td>
                        <td>@appUser.LastChanged.ToString("F", cultureInfo)</td>
                        <td>
                            @if (User.Identity?.Name != appUser.UserName)
                            {
                                <div class="d-flex gap-1 justify-content-start align-items-center">
                                    <a class="btn" asp-action="Edit" asp-route-id="@appUser.Id">
                                        <i class="fas fa-pen-square"></i>
                                    </a>

                                    <!-- Button trigger modal -->
                                    <a class="btn" data-bs-toggle="modal" data-bs-target="#exampleModal@(appUser.Id)">
                                        <i class="fa fa-regular fa-trash"></i>
                                    </a>

                                    @{
                                        var modalVM = new DeleteConfirmationModalVM
                                        {
                                            ModalId = $"exampleModal{appUser.Id}",
                                            ModalTitle = "Hapus Akun",
                                            FormAction = Url.Action("Hapus", "Account", new { Area = "Dashboard", id = appUser.Id })!,
                                        };
                                    }

                                    <partial name="_DeleteConfirmationModalPartial" model="modalVM" />
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>





@section Scripts {
    <partial name="_DataTablePartial" />
}